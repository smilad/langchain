# Copy to .env. Keep real credentials out of source control.
# Plain OpenAI model ID with chat, tool-calling and structured-output support.
OPENAI_API_KEY=
COURSE_MODEL=
# Needed only for the real semantic-retrieval comparison, not lexical checks.
COURSE_EMBEDDING_MODEL=
# Set to 1 only when you consent to remote requests and provider charges.
COURSE_ALLOW_LIVE=0
# Optional OpenAI-compatible endpoint; capabilities remain provider-specific.
# OPENAI_BASE_URL=
# Optional isolated local persistence directory (default: .course/).
# COURSE_STATE_DIR=
# Local HTTP server authentication: JSON object mapping token -> user ID.
# Use separate tokens; the identities alice/bob/finance match the synthetic corpus.
# COURSE_AUTH_TOKENS={"replace-with-long-random-token":"alice"}
# Hosted tracing is opt-in and sends inputs/outputs to LangSmith.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langchain-learning
